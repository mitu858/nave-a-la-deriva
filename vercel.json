{
  "version": 2,
  "builds": [{ "src": "api/*.ts", "use": "@vercel/node" }],
  "routes": [
    { "src": "^/$", "dest": "api/index.ts" },
    { "src": "^/status$", "dest": "api/status.ts" },
    { "src": "^/repair-bay$", "dest": "api/repair-bay.ts" },
    { "src": "^/teapot$", "dest": "api/teapot.ts" }
  ]
}
